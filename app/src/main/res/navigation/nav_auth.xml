<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth"
    app:startDestination="@id/splash_fragment">

    <fragment
        android:id="@+id/splash_fragment"
        android:name="com.learninge.app.ui.auth.SplashFragment"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/login_fragment"
            app:popUpTo="@id/splash_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.learninge.app.ui.auth.LoginFragment"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/register_fragment" />

        <action
            android:id="@+id/action_login_to_forgot_password"
            app:destination="@id/forgot_password_fragment" />
    </fragment>

    <fragment
        android:id="@+id/register_fragment"
        android:name="com.learninge.app.ui.auth.RegisterFragment"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_register_to_setup"
            app:destination="@id/setup_fragment"
            app:popUpTo="@id/login_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/setup_fragment"
        android:name="com.learninge.app.ui.auth.SetupFragment"
        tools:layout="@layout/fragment_setup" />

    <fragment
        android:id="@+id/forgot_password_fragment"
        android:name="com.learninge.app.ui.auth.ForgotPasswordFragment"
        tools:layout="@layout/fragment_forgot_password" />

</navigation>
