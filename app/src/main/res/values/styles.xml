<?xml version="1.0" encoding="utf-8"?>
<!-- Widget dùng chung (UI-UX-SPECIFICATION §Component list). Màu lấy từ ?attr nên tự đổi theo khu vực. -->
<resources>

    <style name="Widget.LearningE.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LearningE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Full</item>
    </style>

    <style name="Widget.LearningE.Button.Large">
        <item name="android:minHeight">@dimen/button_height_l</item>
    </style>

    <style name="Widget.LearningE.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LearningE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Full</item>
    </style>

    <style name="Widget.LearningE.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LearningE.Label</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Full</item>
    </style>

    <style name="Widget.LearningE.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_m</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.LearningE.Label</item>
    </style>

    <style name="Widget.LearningE.Button.White">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.LearningE.Button.Danger" parent="Widget.LearningE.Button.Outlined">
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="strokeColor">@color/error</item>
    </style>

    <style name="Widget.LearningE.Button.Success">
        <item name="backgroundTint">@color/success</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="iconTint">@color/on_primary</item>
    </style>

    <style name="Widget.LearningE.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.LearningE.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.LearningE.TitleL</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.LearningE.Caption</item>
    </style>

    <style name="Widget.LearningE.Toolbar.Hero">
        <item name="titleTextColor">@color/on_hero</item>
        <item name="subtitleTextColor">@color/on_hero_variant</item>
        <item name="navigationIconTint">@color/on_hero</item>
    </style>

    <style name="Widget.LearningE.Badge" parent="">
        <item name="android:textAppearance">@style/TextAppearance.LearningE.Caption</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">@dimen/space_2</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="android:paddingTop">@dimen/badge_padding</item>
        <item name="android:paddingBottom">@dimen/badge_padding</item>
    </style>

    <style name="Widget.LearningE.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">@dimen/elevation_1</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Large</item>
    </style>

    <style name="Widget.LearningE.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Large</item>
    </style>

    <style name="Widget.LearningE.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Medium</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="errorIconDrawable">@drawable/ic_info</item>
    </style>

    <style name="Widget.LearningE.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.LearningE.Medium</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.LearningE.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">@dimen/progress_thickness</item>
        <item name="trackCornerRadius">@dimen/space_1</item>
        <item name="trackColor">@color/surface_variant</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.LearningE.Progress.Hero">
        <item name="indicatorColor">@color/on_hero</item>
        <item name="trackColor">@color/hero_track</item>
    </style>

    <style name="ShapeAppearance.LearningE.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="ShapeAppearance.LearningE.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <style name="ShapeAppearance.LearningE.Full" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>
</resources>
