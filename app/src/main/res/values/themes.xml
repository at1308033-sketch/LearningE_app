    <style name="ThemeOverlay.LearningE.Streak">
        <item name="colorPrimary">@color/feat_streak</item>
        <item name="colorOnPrimary">@color/on_feat_streak</item>
        <item name="colorPrimaryContainer">@color/feat_streak_container</item>
        <item name="colorOnPrimaryContainer">@color/feat_streak</item>
        <item name="colorSecondaryContainer">@color/feat_streak_container</item>
        <item name="colorOnSecondaryContainer">@color/feat_streak</item>
    </style>
</resources>
