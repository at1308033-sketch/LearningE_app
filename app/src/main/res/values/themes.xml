        <item name="colorSecondaryContainer">@color/feat_exam_container</item>
        <item name="colorOnSecondaryContainer">@color/feat_exam</item>
    </style>

    <style name="ThemeOverlay.LearningE.Deck">
        <item name="colorPrimary">@color/feat_deck</item>
        <item name="colorOnPrimary">@color/on_feat_deck</item>
        <item name="colorPrimaryContainer">@color/feat_deck_container</item>
        <item name="colorOnPrimaryContainer">@color/feat_deck</item>
        <item name="colorSecondaryContainer">@color/feat_deck_container</item>
        <item name="colorOnSecondaryContainer">@color/feat_deck</item>
