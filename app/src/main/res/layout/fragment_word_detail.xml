<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.LearningE.Learn">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/common_back"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:title="@string/word_title" />

    <com.learninge.app.ui.common.EmptyStateView
        android:id="@+id/es_word"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_word"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/feat_learn_container"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_level"
                            style="@style/Widget.LearningE.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            tools:text="A1" />

                        <TextView
                            android:id="@+id/tv_pos"
                            style="@style/Widget.LearningE.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_outlined"
                            tools:text="danh từ" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_term"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.LearningE.Display"
                        tools:text="mother" />

                    <TextView
                        android:id="@+id/tv_reading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LearningE.Ipa"
                        android:textColor="@color/feat_learn"
                        tools:text="/ˈmʌðər/" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_speak"
                            style="@style/Widget.LearningE.RoundButton"
                            android:contentDescription="@string/word_speak"
                            app:icon="@drawable/ic_volume" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_favorite"
                            style="@style/Widget.LearningE.RoundButton.Heart"
                            android:layout_marginStart="@dimen/space_3"
                            android:contentDescription="@string/favorite"
                            app:icon="@drawable/ic_heart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_meaning"
                        android:textAppearance="@style/TextAppearance.LearningE.Overline" />

                    <TextView
                        android:id="@+id/tv_meaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.LearningE.TitleL"
                        tools:text="mẹ" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_example"
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/tv_example_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/word_example"
                        android:textAppearance="@style/TextAppearance.LearningE.Overline"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_speak_example"
                        style="@style/Widget.LearningE.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/word_speak_example"
                        app:icon="@drawable/ic_volume"
                        app:iconTint="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_example"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.LearningE.BodyL"
                        app:layout_constraintEnd_toStartOf="@id/btn_speak_example"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_example_label"
                        tools:text="My mother cooks dinner every evening." />

                    <TextView
                        android:id="@+id/tv_example_translation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:textAppearance="@style/TextAppearance.LearningE.BodyM"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_example"
                        tools:text="Mẹ tôi nấu bữa tối mỗi tối." />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/tv_box"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.LearningE.BodyM"
                        tools:text="Hộp 4/5 · ôn lại sau 6 ngày" />

                    <TextView
                        android:id="@+id/tv_status"
                        style="@style/Widget.LearningE.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Đang học" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
