<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_answer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_answer"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:contentDescription="@string/exam_correct"
            tools:src="@drawable/ic_check" />

        <TextView
            android:id="@+id/tv_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_3"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.LearningE.Label"
            tools:text="Câu 7: submitted" />

        <ImageView
            android:id="@+id/iv_answer_chevron"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_chevron_right"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_card_tint"
        android:orientation="vertical"
        android:padding="@dimen/space_3"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_answer_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LearningE.BodyM"
            tools:text="The report must be ___ by Friday." />

        <TextView
            android:id="@+id/tv_answer_correct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.LearningE.Label"
            tools:text="Đáp án đúng: submitted" />

        <TextView
            android:id="@+id/tv_answer_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="@style/TextAppearance.LearningE.BodyM" />
    </LinearLayout>
</LinearLayout>
