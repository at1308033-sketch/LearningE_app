<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LearningE.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_4"
    android:layout_marginVertical="@dimen/space_1">

    <LinearLayout
        android:id="@+id/ll_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_3"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_word_term"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LearningE.TitleS"
                tools:text="mother" />

            <TextView
                android:id="@+id/tv_word_reading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LearningE.Ipa"
                android:textSize="14sp"
                tools:text="/ˈmʌðər/" />

            <TextView
                android:id="@+id/tv_word_meaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.LearningE.BodyM"
                tools:text="mẹ" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_word_status"
            style="@style/Widget.LearningE.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            tools:text="Đang học" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
