<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.LearningE.Deck">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_deck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_deck"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_4">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_deck"
                style="@style/Widget.LearningE.Toolbar.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:menu="@menu/menu_deck"
                app:navigationContentDescription="@string/common_back"
                app:navigationIcon="@drawable/ic_arrow_left"
                tools:title="Từ vựng công việc" />

            <TextView
                android:id="@+id/tv_deck_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.LearningE.Label"
                android:textColor="@color/on_hero"
                tools:text="EN · 24 từ · 5 thẻ cần ôn" />

            <TextView
                android:id="@+id/tv_deck_read_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_4"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_hero_chip"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_1"
                android:text="@string/deck_read_only"
                android:textAppearance="@style/TextAppearance.LearningE.Caption"
                android:textColor="@color/on_hero" />

            <LinearLayout
                android:id="@+id/ll_deck_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_4"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_deck_learn"
                    style="@style/Widget.LearningE.Button.White"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_learn"
                    app:icon="@drawable/ic_book_open"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_deck_words"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/fab_space"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.learninge.app.ui.common.EmptyStateView
                android:id="@+id/es_deck"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone"
                app:emptyArt="@drawable/ill_empty_decks" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="@dimen/space_4"
        android:text="@string/word_add_title"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimary"
        app:icon="@drawable/ic_plus"
        app:iconTint="?attr/colorOnPrimary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
