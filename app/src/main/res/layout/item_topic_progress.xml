<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_topic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_tile"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_topic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.LearningE.Label"
            tools:text="Gia đình" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pi_topic"
            style="@style/Widget.LearningE.Progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_topic_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.LearningE.Caption"
        tools:text="16/20 từ" />
</LinearLayout>
