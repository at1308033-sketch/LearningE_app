<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.LearningE.Exam">

    <LinearLayout
        android:id="@+id/header_exam_hub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_exam"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_3">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_exam_hub"
            style="@style/Widget.LearningE.Toolbar.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationContentDescription="@string/common_back"
            app:navigationIcon="@drawable/ic_arrow_left"
            app:title="@string/exam_hub_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exam_hub_headline"
                    android:textAppearance="@style/TextAppearance.LearningE.TitleL"
                    android:textColor="@color/on_hero" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exam_hub_source"
                    android:textAppearance="@style/TextAppearance.LearningE.Caption"
                    android:textColor="@color/on_hero_variant" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/hero_art_width"
                android:layout_height="@dimen/hero_art_height"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ill_exam_prep" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <LinearLayout
                android:id="@+id/ll_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/row_history"
                        style="@style/Widget.LearningE.SettingRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_history"
                        app:drawableStartCompat="@drawable/ic_history" />

                    <TextView
                        android:id="@+id/row_resources"
                        style="@style/Widget.LearningE.SettingRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/resources_title"
                        app:drawableStartCompat="@drawable/ic_external_link" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
