<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.LearningE.Streak">

    <LinearLayout
        android:id="@+id/header_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_streak"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationContentDescription="@string/common_back"
            app:navigationIcon="@drawable/ic_arrow_left"
            app:title="@string/progress_title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/progress_current_streak"
                    android:textAppearance="@style/TextAppearance.LearningE.Caption"
                    android:textColor="@color/on_sun" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_streak_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LearningE.DisplayNum"
                        tools:text="5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/progress_days_in_row"
                        android:textAppearance="@style/TextAppearance.LearningE.TitleM" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_streak_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.LearningE.Caption"
                    android:textColor="@color/on_sun"
                    tools:text="Kỷ lục: 12 ngày" />

                <TextView
                    android:id="@+id/tv_streak_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/progress_no_streak"
                    android:textAppearance="@style/TextAppearance.LearningE.Label" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/fl_flame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/ll_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <FrameLayout
                android:id="@+id/fl_game"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_week"
                        android:textAppearance="@style/TextAppearance.LearningE.TitleS" />

                    <com.learninge.app.ui.common.BarChartView
                        android:id="@+id/chart_week"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/tv_mastered_of"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.LearningE.TitleS"
                        tools:text="Đã thuộc 16/300 từ" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/Widget.LearningE.StatColumn">

                            <TextView
                                android:id="@+id/tv_new"
                                style="@style/Widget.LearningE.StatNumber"
                                tools:text="270" />

                            <TextView
                                style="@style/Widget.LearningE.StatLabel"
                                android:text="@string/word_status_new" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.LearningE.StatColumn">

                            <TextView
                                android:id="@+id/tv_learning"
                                style="@style/Widget.LearningE.StatNumber"
                                tools:text="14" />

                            <TextView
                                style="@style/Widget.LearningE.StatLabel"
                                android:text="@string/word_status_learning" />
                        </LinearLayout>

                        <LinearLayout style="@style/Widget.LearningE.StatColumn">

                            <TextView
                                android:id="@+id/tv_mastered"
                                style="@style/Widget.LearningE.StatNumber"
                                tools:text="16" />

                            <TextView
                                style="@style/Widget.LearningE.StatLabel"
                                android:text="@string/word_status_mastered" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_quiz_average"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:textAppearance="@style/TextAppearance.LearningE.BodyM"
                        tools:text="Điểm quiz trung bình 7 ngày: 82" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LearningE.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/progress_by_topic"
                        android:textAppearance="@style/TextAppearance.LearningE.TitleS" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_topic_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
