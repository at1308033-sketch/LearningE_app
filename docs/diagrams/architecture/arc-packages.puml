@startuml
!include ../_style.puml
set separator none
title Sơ đồ gói com.learninge.app (app) và Gradle multi-module LearningE_Server (proto, common, 6 dịch vụ, all-in-one; com.learninge.server.<module>) và hướng phụ thuộc (CR-007, CR-008)
skinparam dpi 100
hide empty members
hide circle

package "Repo app — module :app — com.learninge.app" as APP {
  class LearningEApp
  package "ui" {
    package "ui.auth" as uiauth {
  }
    package "ui.main" as uimain {
  }
    package "ui.home · ui.learn · ui.practice\nui.search · ui.me" as uitabs {
  }
    package "ui.study · ui.quiz · ui.deck\nui.exam · ui.leaderboard · ui.sync" as uifeat {
  }
    package "ui.common\n(TtsHelper, BarChartView,\nEmptyStateView, pixel views)" as uicommon {
  }
  }
  package "domain\n(Service, XpService,\nLeaderboardService, ContentService)" as domain {
  }
  package "domain.rules\n(Java thuần, không android.*:\nLeitner, Streak, QuizGenerator,\nFlameStage, ThemeStars, ChestCounts)" as rules {
  }
  package "sync\n(SyncManager, SyncScheduler,\nsync.mapper.*)" as sync {
  }
  package "data" {
    package "data.remote — tầng gRPC (DEC-020)\n(GrpcClient, AuthRemote, SyncRemote,\nLeaderboardRemote, ContentRemote,\nAuth/RequestIdInterceptor, GrpcErrorMapper,\nRetryPolicy, TokenStore, NetworkMonitor,\nServerConfig)" as remote {
  }
    package "learninge.app.v1.*\n(stub sinh từ proto — Java lite,\nchỉ data.remote được import)" as stub {
  }
    package "data.repo" as repo {
  }
    package "data.dao" as dao {
  }
    package "data.db\n(DatabaseHelper, SeedLoader)" as db {
  }
    package "data.model\n(POJO)" as model {
  }
    package "data.io\n(JsonCodec, org.json)" as dio {
  }
  }
  package "core\n(ServiceLocator, AppExecutors\nmain/dbRead/dbWrite/io,\nResult<T>, ErrorCode)" as core {
  }
  package "reminder\n(ReminderReceiver, BootReceiver)" as reminder {
  }
}

package "Repo LearningE_Server — Gradle multi-module, Kotlin DSL (Java 21, Spring Boot 4.1.2) — gói com.learninge.server.<module>" as SRV {
  package "proto\n(src/main/proto: learninge/app/v1 + internal/v1 —\nnguồn sự thật; app chép bản sao + proto.lock)" as protofiles {
  }
  package "module proto (java-library)\nplugin com.google.protobuf → message + stub grpc-java\ncom.learninge.server.proto" as cproto {
  }
  package "module common (java-library) — com.learninge.server.common\ngrpc (interceptor, AppExceptionHandler) · error (AppException, ErrorCode)\nconfig · sqlite (DataSource, TxRunner) · outbox (OutboxWriter, OutboxRelay)\nops · id (UuidV7, UuidV5)" as ccommon {
  }
  package "Module dịch vụ — mỗi module = một ứng dụng Spring Boot (<Svc>Application + <Svc>ServiceConfig)\nmỗi module chia gói grpc → domain → store" as SVCS {
  package "module edge — com.learninge.server.edge\n(forwarders, TokenAuthenticator + Caffeine,\nIpRateLimiter, GetMeComposer)" as sedge {
  }
  package "module auth — com.learninge.server.auth\n(domain: PasswordHasher, LockPolicy, TokenService\nstore: JdbcClient auth.db · db/migration/auth)" as sauth {
  }
  package "module sync — com.learninge.server.sync\n(domain: LwwPolicy, XpValidator, StreakCalculator\nstore: JdbcClient sync.db · db/migration/sync)" as ssync {
  }
  package "module content — com.learninge.server.content\n(store: Spring Data MongoDB; --ops=import)" as scontent {
  }
  package "module gamification — com.learninge.server.gamification\n(IsoWeek, DailyCap, Ranking · MongoDB; --ops=rebuild)" as sgame {
  }
  package "module insight — com.learninge.server.insight\n(store: MongoDB, TTL index)" as sinsight {
  }
  }
  package "module all-in-one\n(AllInOneApplication: 6 context Spring con trong 1 JVM,\ncờ <U+002D><U+002D>all hoặc <U+002D><U+002D>only=edge,auth; nội bộ nghe 127.0.0.1)" as sbin {
  }
  package "content-data/ (JSON nguồn)\ndeploy/ (compose, Dockerfile nhiều stage)" as sdeploy {
  }
}

LearningEApp ..> core
uiauth ..> domain
uimain ..> uitabs
uitabs ..> domain
uifeat ..> domain
uitabs ..> uicommon
uifeat ..> uicommon
domain ..> rules
domain ..> repo
domain ..> remote
domain ..> sync
domain ..> dio
sync ..> remote
sync ..> repo
repo ..> dao
repo ..> remote : (token, userId)
remote ..> stub
dao ..> db
dao ..> model
domain ..> model
reminder ..> domain
core ..> domain
core ..> db
stub ..> protofiles : bản sao learninge.app.v1\n(tools/sync-proto.ps1)
remote ..> sedge : gRPC (h2/TLS) learninge.app.v1\n(hợp đồng API_CONTRACT, không phụ thuộc mã)

protofiles ..> cproto : plugin protobuf (Gradle)
SVCS ..> cproto
SVCS ..> ccommon
sbin ..> SVCS
sdeploy ..> sbin : đóng gói image

legend bottom
  Quy tắc app: ui → domain → data (gồm data.remote); chỉ data.remote import mã sinh từ proto và io.grpc.*; sync được domain gọi, không phụ thuộc ui;
  domain.rules không import android.*; DAO không chứa quy tắc nghiệp vụ; ViewModel không giữ Context của Activity.
  Quy tắc server: mỗi dịch vụ là một module Gradle = ứng dụng Spring Boot; gói grpc → domain (Java thuần, không Spring) → store (JdbcClient / MongoTemplate); module dịch vụ không phụ thuộc module dịch vụ khác (chỉ qua stub của module proto, kiểm bằng dependency Gradle);
  user_id chỉ lấy từ metadata x-user-id do edge gắn sau khi qua InternalAuthServerInterceptor (x-internal-auth). common dùng được ở mọi tầng.
endlegend
@enduml
