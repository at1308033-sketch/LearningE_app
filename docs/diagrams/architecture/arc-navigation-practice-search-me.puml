@startuml
!include ../_style.puml
title Bản đồ màn hình (2/2) — tab Luyện tập, Tra từ và Tôi (CR-006: SCR-34, SCR-35; SCR-16/17 Won't, SCR-18 Could)
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #5146E0
}
skinparam frame {
  BorderColor #8B88A8
  BackgroundColor #FAFAFF
}

frame "Tab Luyện tập" {
  rectangle "SCR-12\nChọn quiz" as S12
  rectangle "SCR-15\nLịch sử quiz" as S15
  rectangle "SCR-16\nDanh sách ngữ pháp\n[Won't]" as S16 #E6E6EC
  rectangle "SCR-17\nChi tiết bài\n[Won't]" as S17 #E6E6EC
  rectangle "SCR-30\nLuyện thi" as S30
  rectangle "SCR-33\nTài nguyên chính thức" as S33
}

frame "Toàn màn hình (ẩn thanh tab)" {
  rectangle "SCR-13\nLàm quiz\n(DECK / GRAMMAR)" as S13
  rectangle "SCR-14\nKết quả quiz" as S14
  rectangle "SCR-31\nLàm bài thi thử" as S31
  rectangle "SCR-32\nKết quả thi thử" as S32
}

frame "Tab Tra từ" {
  rectangle "SCR-18\nTra từ [Could]\n(Kết quả / Yêu thích / Sổ tay)" as S18 #FFF8DB
  rectangle "SCR-08\nChi tiết từ" as S08
  rectangle "SCR-19\nChi tiết bộ" as S19
}

frame "Tab Tôi" {
  rectangle "SCR-22\nHồ sơ & cài đặt" as S22
  rectangle "SCR-21\nTiến độ" as S21
  rectangle "SCR-23\nĐổi mật khẩu" as S23
  rectangle "SCR-24\nGiới thiệu" as S24
  rectangle "SCR-34\nBảng xếp hạng tuần\n(cần mạng; ngoại tuyến: bản lưu)" as S34
  rectangle "SCR-35\nTrạng thái đồng bộ\n(Đồng bộ ngay)" as S35
}

rectangle "Trình duyệt\n(ứng dụng khác)" as BRW
rectangle "SCR-02\nĐăng nhập" as S02

S12 --> S13 : source=DECK, refId
S12 --> S15
S12 --> S16
S16 --> S17
S17 --> S13 : source=GRAMMAR
S13 --> S14
S12 --> S30
S30 --> S31 : testCode
S31 --> S32
S30 --> S33
S33 --> BRW : ACTION_VIEW
S30 --> S19 : bộ từ kỳ thi

S18 --> S08 : wordId
S18 --> S19 : deckId

S22 --> S21
S22 --> S23
S22 --> S24
S22 --> S34 : Bảng xếp hạng
S22 --> S35 : Đồng bộ
S34 ..> S35 : mất mạng, dùng dữ liệu đã lưu
S35 ..> S02 : UNAUTHENTICATED (phiên hết hạn)
S22 ..> S02 : đăng xuất
@enduml
