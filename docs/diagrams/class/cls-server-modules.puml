@startuml
!include ../_style.puml
skinparam dpi 105
left to right direction
set separator none
title Gradle multi-module LearningE_Server (Java 21 + Spring Boot) — proto · common · edge · auth · sync · content · gamification · insight (CR-007, CR-008, DEC-018..DEC-024)
skinparam classAttributeIconSize 0
hide empty members

package "module proto — com.learninge.server.proto" as proto {
  interface "learninge.app.v1\nAuthServiceGrpc · SyncServiceGrpc ·\nLeaderboardServiceGrpc · ContentServiceGrpc" as AppV1 <<ImplBase / BlockingStub>>
  interface "learninge.internal.v1\nAuthBackend · TokenValidator · SyncBackend ·\nContentBackend · GamificationBackend ·\nInsightBackend · EventSink" as IntV1 <<ImplBase / BlockingStub>>
}

package "module common — com.learninge.server.common" as common {
  class AppException <<RuntimeException>> {
    ErrorCode (mã nghiệp vụ CR-006:
    EMAIL_TAKEN, ACCOUNT_LOCKED…)
  }
  class AppExceptionHandler <<GrpcExceptionHandler>> {
    AppException → Status + trailer error-code
  }
  class RequestIdServerInterceptor <<@GlobalServerInterceptor>> {
    x-request-id → MDC
  }
  class InternalAuthServerInterceptor <<@GlobalServerInterceptor>> {
    x-internal-auth = LEARNINGE_INTERNAL_TOKEN
    MessageDigest.isEqual trên SHA-256
  }
  class InternalAuthClientInterceptor
  class ConcurrencyLimitInterceptor
  class DeadlineCapInterceptor
  class CallerContext {
    +userId() từ x-user-id
  }
  class SqliteDataSources {
    ghi: Hikari 1 kết nối · đọc: Hikari 4
    WAL, quick_check
  }
  class TxRunner {
    BEGIN IMMEDIATE
  }
  class "Flyway\n(db/migration/<svc>)" as Flyway <<spring-boot-starter-flyway>>
  class OutboxWriter {
    +enqueue(tx, Event, destinations)
  }
  class OutboxRelay <<@Scheduled(fixedDelay = 1 s)>> {
    mỗi đích một tiến độ
    lùi 1 s → 15 s, hỏi grpc.health.v1 của đích
  }
  class EventRouting {
    loại sự kiện → danh sách đích
  }
  class LearningeProperties <<@ConfigurationProperties>>
  class OpsCommandRunner {
    ops=import hoặc ops=rebuild rồi thoát
  }
  class "java.time.Clock" as Clock <<bean>>
}

package "module edge  :50051  (+ Actuator 127.0.0.1:8081)" as edge {
  class EdgeApplication <<@SpringBootApplication>>
  class AuthForwarder <<@GrpcService>> {
    extends AuthServiceGrpc.AuthServiceImplBase
    mỗi RPC một hàm chuyển tiếp
  }
  class SyncForwarder <<@GrpcService>>
  class LeaderboardForwarder <<@GrpcService>>
  class ContentForwarder <<@GrpcService>>
  class TokenAuthenticator <<ServerInterceptor>> {
    xóa x-user-id / x-internal-* từ client
    ValidateToken → gắn x-user-id
  }
  class TokenCache <<Caffeine>> {
    token_sha256 → user_id, user_hmac
    expireAfterWrite 60 s, xóa theo user
  }
  class IpRateLimiter <<Caffeine>>
  class GetMeComposer {
    GetMe = auth.GetProfile +
    sync.GetStreak và gamification.GetStats
  }
  class RequestLogShipper {
    hàng đợi ≤ 1000 mục, best-effort
  }
}

package "module auth  :50052" as auth {
  class AuthBackendGrpcService <<@GrpcService>> {
    extends AuthBackendGrpc.AuthBackendImplBase
  }
  class TokenValidatorGrpcService <<@GrpcService>>
  class PasswordHasher {
    PBKDF2 120.000 vòng (javax.crypto),
    Semaphore ≤ 4 phép đồng thời
  }
  class TokenService {
    256 bit, lưu SHA-256, 30 ngày
  }
  class LockPolicy {
    5 lần sai → 60 s, ×2, ≤ 1 giờ
  }
  class AuthRepository <<JdbcClient · auth.db>>
}

package "module sync  :50053" as sync {
  class SyncBackendGrpcService <<@GrpcService>>
  class SyncEventSinkGrpcService <<@GrpcService · EventSink>> {
    user.registered → bộ "Sổ tay" UUIDv5
    user.deleted → purge + purged_users
  }
  class LwwPolicy
  class XpValidator {
    BR-065..BR-068, trần 500 XP/ngày
  }
  class StreakCalculator
  class SyncRepository <<JdbcClient · sync.db>>
}

package "module content  :50054" as content {
  class ContentBackendGrpcService <<@GrpcService>>
  class ContentRepository <<Spring Data MongoDB · learninge_content>>
  class ContentImporter {
    --ops=import: content-data/*.json
  }
}

package "module gamification  :50055" as game {
  class GamificationBackendGrpcService <<@GrpcService>>
  class GameEventSinkGrpcService <<@GrpcService · EventSink>>
  class IsoWeek {
    Asia/Ho_Chi_Minh
  }
  class DailyCap
  class Ranking {
    hòa → đạt sớm hơn
  }
  class GameRepository <<Spring Data MongoDB · learninge_game>>
}

package "module insight  :50056" as insight {
  class InsightBackendGrpcService <<@GrpcService>>
  class InsightEventSinkGrpcService <<@GrpcService · EventSink>>
  class AnalyticsAggregator
  class InsightRepository <<Spring Data MongoDB · learninge_insight, TTL index>>
}

class "module all-in-one — AllInOneApplication\n(6 context Spring con trong 1 JVM: cờ <U+002D><U+002D>all hoặc <U+002D><U+002D>only=edge,auth)" as AllInOne

AuthForwarder --> TokenAuthenticator
AuthForwarder --> GetMeComposer
TokenAuthenticator --> TokenCache
AuthForwarder --> IpRateLimiter
SyncForwarder ..> RequestLogShipper : request_logs
LeaderboardForwarder ..> GamificationBackendGrpcService : gRPC h2c
ContentForwarder ..> ContentBackendGrpcService : gRPC h2c
RequestLogShipper ..> InsightBackendGrpcService : LogRequests
AuthForwarder ..> AuthBackendGrpcService : gRPC h2c (BlockingStub)
SyncForwarder ..> SyncBackendGrpcService : gRPC h2c

AuthBackendGrpcService --> PasswordHasher
AuthBackendGrpcService --> LockPolicy
AuthBackendGrpcService --> TokenService
AuthBackendGrpcService --> AuthRepository
SyncBackendGrpcService --> LwwPolicy
SyncBackendGrpcService --> XpValidator
SyncBackendGrpcService --> StreakCalculator
SyncBackendGrpcService --> SyncRepository
SyncEventSinkGrpcService --> SyncRepository
ContentBackendGrpcService --> ContentRepository
ContentImporter --> ContentRepository
GamificationBackendGrpcService --> Ranking
GamificationBackendGrpcService --> IsoWeek
GameEventSinkGrpcService --> DailyCap
GameEventSinkGrpcService --> GameRepository
GamificationBackendGrpcService --> GameRepository
InsightEventSinkGrpcService --> AnalyticsAggregator
InsightEventSinkGrpcService --> InsightRepository

AuthRepository --> SqliteDataSources
SyncRepository --> SqliteDataSources
SqliteDataSources --> Flyway
AuthRepository ..> TxRunner
SyncRepository ..> TxRunner
AuthRepository ..> OutboxWriter : cùng giao dịch
SyncRepository ..> OutboxWriter : cùng giao dịch
OutboxWriter --> EventRouting
OutboxRelay ..> IntV1 : EventSink.Publish
OutboxRelay ..> InternalAuthClientInterceptor
OutboxRelay ..> OutboxWriter : đọc bảng outbox
AuthBackendGrpcService ..> IntV1 : implements
AuthForwarder ..> AppV1 : implements
AuthBackendGrpcService ..> AppException
AppExceptionHandler ..> AppException
InternalAuthServerInterceptor ..> CallerContext : trước khi đọc x-user-id
AllInOne ..> EdgeApplication : khởi context con

legend bottom
  Mỗi dịch vụ: grpc (@GrpcService kế thừa ImplBase sinh từ proto, đổi message ↔ kiểu miền, ném AppException → Status) → domain (Java thuần, không I/O, không annotation Spring, nhận Clock) → store (JdbcClient SQL tham số, hoặc Spring Data MongoDB / MongoTemplate có kiểu).
  Interceptor toàn cục (common): RequestId → InternalAuth → ConcurrencyLimit → DeadlineCap. user_id chỉ lấy từ metadata x-user-id do edge gắn (CallerContext.userId()) sau InternalAuthServerInterceptor; module dịch vụ không phụ thuộc module dịch vụ khác, chỉ qua stub của module proto.
  OutboxRelay (@Scheduled) chạy trong JVM của auth và sync. Mỗi module dịch vụ là một ứng dụng Spring Boot; Actuator chỉ ở 127.0.0.1:8081 nội bộ.
endlegend
@enduml
