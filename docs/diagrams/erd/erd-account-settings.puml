@startuml
!include ../_style.puml
title ERD — Tài khoản & cài đặt (users, user_settings, seed_meta)
hide circle
left to right direction

entity "users" as users {
  * id : INTEGER <<PK>>
  --
  * username : TEXT <<UK>> -- chữ thường
  display_name : TEXT
  * password_hash : TEXT -- hex
  * password_salt : TEXT -- hex, 16 byte
  security_question_id : INTEGER -- CHECK 1..5
  * security_answer_hash : TEXT
  * security_answer_salt : TEXT
  failed_login_count : INTEGER
  login_locked_until : INTEGER -- epoch ms
  failed_reset_count : INTEGER
  reset_locked_until : INTEGER -- epoch ms
  onboarded : INTEGER -- 0/1
  created_at : INTEGER
}

entity "user_settings" as us {
  * user_id : INTEGER <<PK, FK>>
  --
  level : TEXT -- IN ('A1','A2','B1')
  daily_goal : INTEGER -- IN (5,10,15,20)
  reminder_enabled : INTEGER -- 0/1
  reminder_minute : INTEGER -- 0..1439
  current_streak : INTEGER
  longest_streak : INTEGER
  last_study_date : TEXT -- yyyy-MM-dd
}

entity "seed_meta" as sm {
  * key : TEXT <<PK>>
  --
  value : TEXT -- vd seed_version
}

users ||--|| us : "có (CASCADE)"

note bottom of users
  Cha của decks, card_progress, favorites,
  grammar_progress, quiz_attempts, exam_attempts,
  study_log (đều ON DELETE CASCADE — BR-005)
end note
legend right
  * = NOT NULL · <<PK>> khóa chính
  <<FK>> khóa ngoại · <<UK>> UNIQUE
endlegend
@enduml
