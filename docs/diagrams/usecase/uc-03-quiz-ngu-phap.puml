@startuml
!include ../_style.puml
title Use case chi tiết — Luyện tập: quiz (F3) và ngữ pháp [Won't] (F5)
left to right direction
skinparam usecase<<Won't>> {
  BackgroundColor #E6E6EC
  BorderColor #9A98AD
  FontColor #7A7890
}

actor "Người học" as N

rectangle "LearningE" {
  usecase "UC-008 Làm quiz chủ đề\nvà xem kết quả" as UC8
  usecase "Sinh câu hỏi\n(BR-020, BR-024)" as GEN
  usecase "Chấm điểm, lưu lượt làm\n(BR-022, BR-023, BR-025)" as SCORE
  usecase "Đưa từ sai về hộp 1\n(BR-021)" as WRONG
  usecase "Ghi hoạt động học, tạo xp_event\n(BR-032, BR-066; FLOW-008)" as LOG
  usecase "UC-009 Xem lịch sử quiz" as UC9
  usecase "Xem lại câu sai\ncủa một lượt" as REV
  usecase "UC-012 Học ngữ pháp\nvà làm bài tập" as UC12 <<Won't>>
  usecase "Làm bài tập ngữ pháp\n(có giải thích)" as EX <<Won't>>
}

N -- UC8
N -- UC9
N -- UC12

UC8 ..> GEN : <<include>>
UC8 ..> SCORE : <<include>>
UC8 ..> WRONG : <<include>>
UC8 ..> LOG : <<include>>
UC9 <.. REV : <<extend>>
UC12 <.. EX : <<extend>>\n[bài có bài tập]
EX ..> SCORE : <<include>>
UC12 ..> LOG : <<include>>

note bottom of UC12
  UC-012 [Won't]: hạ xuống ở CR-006 (C1), không làm ở bản này
  (xám). Quiz chỉ còn nguồn DECK; mỗi lượt quiz tạo xp_event
  và đánh dấu dirty để đồng bộ (UC-023).
end note
@enduml
